# Copy to .env and adjust. No secrets belong in this file.
SERVICE_NAME=Microphone Microservice
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8000
LOG_LEVEL=INFO
MICROPHONE_FALLBACK_SAMPLE_RATE=16000
# Comma-separated device-name keywords; empty = OS default input
MICROPHONE_TARGET_KEYWORDS=
MICROPHONE_SHOW_METER=true

# --- What the microphone does to what it hears -------------------------------------------------------------------
# The microphone cuts the stream into utterances (what is said between two silences) and sends one event per
# utterance; STT only transcribes them. The cutting is always on; each treatment below can be switched on or off.
# Volume is the RMS of the 16-bit samples of a chunk (0 to about 32000).
MICROPHONE_SILENCE_THRESHOLD=150
# Seconds of silence that end an utterance
MICROPHONE_SILENCE_LIMIT_SECONDS=2.0
# Speech starts at MICROPHONE_SILENCE_THRESHOLD x this factor (1 = the same volume that counts as silence)
MICROPHONE_SPEECH_START_FACTOR=2.0
# Subtract the slowly changing constant offset of the signal before measuring volume
MICROPHONE_DC_OFFSET_REMOVAL=false
# Measure a smoothed volume (weight of the newest chunk: MICROPHONE_VOLUME_SMOOTHING_FACTOR, 0 to 1) so one click is not speech
MICROPHONE_VOLUME_SMOOTHING=true
MICROPHONE_VOLUME_SMOOTHING_FACTOR=0.1
# Raise the thresholds above the quietest volume heard (speech over 3 x it, silence under 2 x it): a noisy room is not speech
MICROPHONE_NOISE_FLOOR_TRACKING=true
# Rate of the audio that is sent on (linear interpolation); 0 = the device's rate. 16000 is what Whisper uses
MICROPHONE_RESAMPLE_TO_HZ=0
