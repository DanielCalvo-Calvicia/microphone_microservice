# Copy to .env and adjust. No secrets belong in this file.
SERVICE_NAME=Microphone Microservice
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8000
LOG_LEVEL=INFO
MICROPHONE_FALLBACK_SAMPLE_RATE=16000
# Comma-separated device-name keywords; empty = OS default input
MICROPHONE_TARGET_KEYWORDS=
MICROPHONE_SHOW_METER=true
